  <template id="book-tpl">
   <div data-template-id="book-card" class="canva-card rounded-xl p-4 flex items-start justify-between gap-3">
    <div class="flex-1 min-w-0">
     <h3 data-template-id="book-card-title" class="canva-text font-semibold truncate"></h3>
     <p data-template-id="book-card-author" class="canva-text text-sm mt-0.5"></p><span data-template-id="book-card-badge" class="canva-tag inline-block mt-2 text-xs px-2 py-0.5 rounded-full font-medium"></span>
    </div><button class="delete-btn text-red-400 hover:text-red-600 mt-1" aria-label="Delete book"> <i data-lucide="trash-2" style="width:18px;height:18px"></i> </button>
   </div>
  </template>
  <script src="/_sdk/9d3258af1f44fbf1.editing_sdk.js" integrity="sha512-3+HAndrk+HZiTGp2ISu+/bgYK1Xci+cLW89chzrkSCXjd9L9cNh/u9apmMgkep6XBKvCauldOAnZkyNhCjybeA=="></script>
  <script src="/_sdk/0e8d3a91e1c6f495.data_sdk.js" integrity="sha512-c00oDoGjsMgluCLLEyVl3suwEkgjOGGplVFbsilUoBg4aMKNmsL3mwsc9r0dPn95qiSZyjBousQXgROkAW7p/w=="></script>
  <script>
        let books = [];
        const list = document.getElementById('book-list');
        const empty = document.getElementById('empty-state');
        const form = document.getElementById('book-form');
        const submitBtn = form.querySelector('[data-template-id="submit-btn"]');
        const uploadBtn = document.getElementById('upload-pdf-btn');
        const pdfPicker = document.getElementById('pdf-picker');

        uploadBtn.addEventListener('click', () => pdfPicker.click());
        pdfPicker.addEventListener('change', () => {
            const file = pdfPicker.files[0];
            if (!file) return;
            document.getElementById('inp-file').value = file.name;
            document.getElementById('inp-type').value = 'PDF';
        });

        const handler = {
            onDataChanged(data) {
                books = data;
                renderBooks();
            }
        };

        function renderBooks() {
            empty.classList.toggle('hidden', books.length > 0);
            const existing = new Map([...list.children].map(el => [el.dataset.id, el]));
            const ids = new Set(books.map(b => b.__backendId));

            existing.forEach((el, id) => { if (!ids.has(id)) el.remove(); });

            books.forEach(book => {
                if (existing.has(book.__backendId)) return;
                const tpl = document.getElementById('book-tpl');
                const node = tpl.content.cloneNode(true);
                const wrap = node.firstElementChild;
                wrap.dataset.id = book.__backendId;
                wrap.querySelector('[data-template-id="book-card-title"]').textContent = book.title;
                wrap.querySelector('[data-template-id="book-card-author"]').textContent = book.author;
                wrap.querySelector('[data-template-id="book-card-badge"]').textContent = book.file_type;
                wrap.querySelector('.delete-btn').addEventListener('click', () => deleteBook(book));
                list.appendChild(node);
                lucide.createIcons();
            });
        }

        async function deleteBook(book) {
            const result = await window.dataSdk.delete(book);
            if (!result.isOk) alert && void 0;
        }

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            if (books.length >= 999) return;
            submitBtn.disabled = true;
            const record = {
                title: document.getElementById('inp-title').value.trim(),
                author: document.getElementById('inp-author').value.trim(),
                file_name: document.getElementById('inp-file').value.trim(),
                file_type: document.getElementById('inp-type').value,
                uploaded_at: new Date().toISOString()
            };
            const result = await window.dataSdk.create(record);
            submitBtn.disabled = false;
            if (result.isOk) form.reset();
        });

        (async () => {
            await window.dataSdk.init(handler);
            lucide.createIcons();
        })();
    </script>
 
